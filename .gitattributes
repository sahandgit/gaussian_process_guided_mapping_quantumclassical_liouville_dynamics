* text=auto

# Source code and documentation should stay LF in the repository
*.py text eol=lf
*.md text eol=lf
*.toml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.cff text eol=lf
*.in text eol=lf
*.txt text eol=lf
*.json text eol=lf
*.ipynb text eol=lf

# Windows launcher files should remain Windows-style
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary/scientific output files
*.png binary
*.jpg binary
*.jpeg binary
*.pdf binary
*.npz binary
*.npy binary
*.pkl binary
*.zip binary
